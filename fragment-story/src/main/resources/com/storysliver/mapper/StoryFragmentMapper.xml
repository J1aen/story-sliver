<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.storysliver.mapper.StoryFragmentMapper">
    <!-- 管理列表：status 为空查全部，不为空按状态筛选；分页由 PageHelper 注入 -->
    <select id="selectManagePage" resultType="com.storysliver.pojo.StoryFragment">
        select id, user_id, content, like_count, is_anonymous, status, created_at, updated_at
        from story_fragment
        <where>
            <if test="status != null">
                status = #{status}
            </if>
        </where>
        order by created_at desc, id desc
    </select>
</mapper>
